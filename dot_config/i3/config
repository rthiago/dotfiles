# i3 config (v4)

set $mod Mod4

# ── Fonts ─────────────────────────────────────────────────────────────────────
# Used for tab/stack titles (pixel borders draw no titlebar otherwise).
font pango:JetBrains Mono 10

# ── Look & feel ───────────────────────────────────────────────────────────────
default_border pixel 2
default_floating_border pixel 2
gaps inner 10
gaps outer 5
focus_follows_mouse no
floating_modifier $mod

# Dracula palette (focused border is solid purple).
set $bg      #282a36
set $current #44475a
set $fg      #f8f8f2
set $comment #6272a4
set $purple  #bd93f9
set $pink    #ff79c6
set $red     #ff5555

#                       border   background text     indicator child_border
client.focused          $purple  $purple    $bg      $pink     $purple
client.focused_inactive $current $current   $fg      $current  $current
client.unfocused        $bg      $bg        $comment $bg       $bg
client.urgent           $red     $red       $fg      $red      $red

# ── Monitors ──────────────────────────────────────────────────────────────────
# Layout (modes, positions, rotation, refresh) is owned by nvidia-settings ->
# /etc/X11/xorg.conf metamodes, NOT by an xrandr line here. Real outputs are
# DP-0 (Samsung G9, 5120x1440) + DP-2 (3440x1440 portrait). Do NOT add an
# `exec_always xrandr` line back: it re-runs every login and clobbers the
# xorg.conf layout (and DP-1 is not the right output name under X11 anyway).
workspace 10 output DP-2

# Keyboard layout
exec_always --no-startup-id setxkbmap us intl

# ── Keybindings ───────────────────────────────────────────────────────────────
bindsym $mod+T exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+e exec thunar
bindsym $mod+Shift+Return floating toggle
bindsym $mod+d exec "rofi -show combi -combi-modi drun,run -theme ~/.config/rofi/launcher.rasi -show-icons"
bindsym $mod+f fullscreen toggle
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Shift+w exec feh --bg-fill --randomize $HOME/Pictures/wallpapers/
bindsym Print exec flameshot gui
bindsym Control+Mod1+l exec i3lock-fancy-rapid 6 4

# Split / layout toggles
bindsym $mod+i layout toggle split
bindsym $mod+o split toggle

# Notifications (dunst has no notification center)
bindsym $mod+n exec dunstctl close
bindsym $mod+m exec dunstctl history-pop
bindsym $mod+Shift+m exec dunstctl close-all

# Focus
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# Focus parent / child
bindsym $mod+a focus parent
bindsym $mod+z focus child

# Move window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

# Switch workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move active container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Tabbed layout
bindsym $mod+w layout toggle tabbed split
bindsym $mod+Control+h focus left
bindsym $mod+Control+l focus right
bindsym $mod+Control+Shift+h move left
bindsym $mod+Control+Shift+l move right
bindsym $mod+Control+Shift+k move up
bindsym $mod+Control+Shift+j move down
bindsym $mod+Mod1+v split v
bindsym $mod+Mod1+b split h

# Resize mode (20px normal / 150px with Shift)
bindsym $mod+r mode "resize"
mode "resize" {
        bindsym h resize shrink width 20 px or 20 ppt
        bindsym l resize grow width 20 px or 20 ppt
        bindsym k resize shrink height 20 px or 20 ppt
        bindsym j resize grow height 20 px or 20 ppt
        bindsym Shift+h resize shrink width 150 px or 10 ppt
        bindsym Shift+l resize grow width 150 px or 10 ppt
        bindsym Shift+k resize shrink height 150 px or 10 ppt
        bindsym Shift+j resize grow height 150 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

# Scratchpads. $mod+s = generic scratchpad (cycles); per-app keys toggle one window.
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad
bindsym $mod+c [class="(?i)gnome-calculator"] scratchpad show
# $mod+b toggles Sublime + Obsidian together.
# Driven by a script: chaining two `scratchpad show` desyncs (one shows while the
# other hides) once their states diverge, so it only swapped between them.
bindsym $mod+b exec --no-startup-id $HOME/scripts/sublime-obsidian-toggle.py
bindsym $mod+g [class="slack"] scratchpad show

# Multimedia keys (wpctl / brightnessctl / playerctl)
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -e4 -n2 set 5%-
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Session management
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ── Window rules ──────────────────────────────────────────────────────────────
# Class strings are X11 WM_CLASS; verify unknowns with `xprop WM_CLASS`.
for_window [window_role="pop-up"] floating enable
for_window [window_role="GtkFileChooserDialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="(?i)pavucontrol"] floating enable, resize set 800 500, move position center
for_window [class="Blueman-manager"] floating enable, resize set 700 450
for_window [class="Nm-connection-editor"] floating enable
for_window [class="(?i)blueberry"] floating enable
for_window [class="(?i)keepassxc"] floating enable
for_window [class="Bitwarden"] floating enable
for_window [class="1Password"] floating enable
for_window [class="Proton Pass"] floating enable
for_window [class="(?i)pinentry"] floating enable
for_window [class="Gcr-prompter"] floating enable
for_window [class="polkit-gnome-authentication-agent-1"] floating enable
for_window [class="YubiKey Manager"] floating enable
for_window [class="Io.ente.auth"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [title="Picture in picture"] floating enable, sticky enable
for_window [class="mpv"] floating enable
for_window [class="vlc"] floating enable
for_window [class="flameshot"] floating enable
for_window [class="(?i)zoom"] floating enable
for_window [class="Gnome-control-center"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [class="Nwg-look"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="(?i)mullvad"] floating enable
for_window [class="(?i)protonvpn"] floating enable
for_window [class="Sparrow"] floating enable
for_window [class="Thunar"] floating enable
for_window [class="Nautilus"] floating enable
for_window [class="file-roller"] floating enable
for_window [class="Solaar"] floating enable
for_window [class="uhk-agent"] floating enable

# Scratchpad apps. Obsidian + Sublime are shown together via $mod+b.
for_window [class="slack"] move scratchpad
# window_type="normal" restricts this to Sublime's MAIN window. Its modal dialogs
# (Save changes? etc.) share class Sublime_text but are window_type dialog; without
# the guard they were moved to the scratchpad too, leaving the editor frozen on an
# invisible modal (Esc cancelled it). i3 auto-floats the dialog on the current ws.
for_window [class="Sublime_text" window_type="normal"] move scratchpad
# border pixel 2: obsidian (Electron) and gnome-calculator (libadwaita CSD) set
# _MOTIF_WM_HINTS asking for no decorations, so i3 draws border none. Force it
# back on, otherwise the focused purple border never appears.
for_window [class="obsidian"] border pixel 2, move scratchpad
for_window [class="(?i)gnome-calculator"] floating enable, border pixel 2, resize set 360 520, move scratchpad

# ── Autostart ─────────────────────────────────────────────────────────────────
# xdg-desktop-portal (flameshot + libadwaita color-scheme) cannot start via
# systemd here: its units require graphical-session.target, which bare i3 (no
# systemd session integration) never brings up, and that target refuses manual
# start. Run the frontend + gtk backend directly instead; portals.conf pins gtk.
# Import the env first so they inherit DISPLAY / XDG_CURRENT_DESKTOP.
exec --no-startup-id dbus-update-activation-environment --systemd --all
exec --no-startup-id /usr/lib/xdg-desktop-portal-gtk
exec --no-startup-id /usr/lib/xdg-desktop-portal -r
exec_always --no-startup-id feh --bg-fill --randomize $HOME/Pictures/wallpapers/
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec_always --no-startup-id "killall -q picom; picom --config ~/.config/picom/picom.conf -b"
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id xautolock -time 30 -locker "i3lock-fancy-rapid 6 4"

# App launches
assign [class="Brave-browser"] number 1
assign [class="btop"] number 10
exec --no-startup-id brave
exec --no-startup-id alacritty --class btop -e btop
exec --no-startup-id slack
exec --no-startup-id subl
exec --no-startup-id obsidian
exec --no-startup-id gnome-calculator
