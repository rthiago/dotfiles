; polybar bar — palette from .chezmoidata/colors.toml, flat.

[colors]
background = #ee{{ trimPrefix "#" .colors.bg }}
background-alt = {{ .colors.bg_highlight }}
foreground = {{ .colors.fg }}
foreground-alt = {{ .colors.muted }}
accent = {{ .colors.purple }}
alert = {{ .colors.red }}
green = {{ .colors.green }}
cyan = {{ .colors.cyan }}
pink = {{ .colors.pink }}
purple = {{ .colors.purple }}
orange = {{ .colors.orange }}
yellow = {{ .colors.yellow }}

; Primary bar: full module set + systray. launch.sh runs this ONLY on the
; primary output. The tray lives here alone so it can't race onto the secondary.
[bar/main]
; launch.sh sets MONITOR per output for dual-monitor
monitor = ${env:MONITOR:}
width = 100%
height = 30
radius = 0
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 2
padding-left = 1
padding-right = 2
module-margin-left = 1
module-margin-right = 2

; font-0 is text + Nerd Font glyphs; verify JetBrainsMono Nerd Font is installed
font-0 = JetBrainsMono Nerd Font:size=11;2
font-1 = JetBrainsMono Nerd Font:size=14;3

modules-left = i3 xwindow
modules-center = date
modules-right = claudeusage codexusage bitcoin headset mousebattery keyboardbattery pulseaudio cpu memory temperature

tray-position = right
tray-padding = 2
tray-background = ${colors.background}

cursor-click = pointer
enable-ipc = true

; Secondary bar: workspaces + focused window title only, no clock/crypto/sensors
; and no tray (this is the portrait monitor). Inherits all look/font/
; color from bar/main; just blanks the center + right modules and the tray.
[bar/secondary]
inherit = bar/main
modules-center =
modules-right =
tray-position = none

[module/i3]
type = internal/i3
format = <label-state> <label-mode>
index-sort = true
wrapping-scroll = false
pin-workspaces = true

label-mode-padding = 2
label-mode-foreground = {{ .colors.bg }}
label-mode-background = ${colors.accent}

label-focused = %index%
label-focused-background = ${colors.background-alt}
label-focused-underline = ${colors.accent}
label-focused-padding = 2

label-unfocused = %index%
label-unfocused-padding = 2

label-visible = %index%
label-visible-background = ${self.label-focused-background}
label-visible-underline = ${self.label-focused-underline}
label-visible-padding = 2

label-urgent = %index%
label-urgent-background = ${colors.alert}
label-urgent-foreground = {{ .colors.bg }}
label-urgent-padding = 2

[module/xwindow]
type = internal/xwindow
label = %title%
label-maxlen = 80
label-foreground = ${colors.foreground}

[module/date]
type = custom/script
exec = date +'%d/%m/%Y  %H:%M'
interval = 5
click-left = gsimplecal
label = %output%
format-foreground = ${colors.accent}
format-underline = ${colors.accent}

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <ramp-volume> <label-volume>
format-volume-foreground = ${colors.pink}
format-volume-underline = ${colors.pink}
label-volume = %percentage%%
label-muted = " muted"
label-muted-foreground = ${colors.alert}
ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 
click-right = pavucontrol

[module/cpu]
type = internal/cpu
interval = 2
format-prefix = " "
format-foreground = ${colors.orange}
format-underline = ${colors.orange}
label = %percentage%%

[module/memory]
type = internal/memory
interval = 2
format-prefix = "󰍛 "
format-foreground = ${colors.purple}
format-underline = ${colors.purple}
label = %percentage_used%%

[module/temperature]
type = internal/temperature
thermal-zone = 0
warn-temperature = 80
; If temp reads wrong/empty, set hwmon-path instead of thermal-zone. Find it via:
;   for f in /sys/class/hwmon/hwmon*/temp*_input; do echo "$f"; done
format = <ramp> <label>
format-foreground = ${colors.yellow}
format-underline = ${colors.yellow}
format-warn = <ramp> <label-warn>
format-warn-underline = ${colors.alert}
label = %temperature-c%
label-warn = %temperature-c%
label-warn-foreground = ${colors.alert}
ramp-0 = 
ramp-1 = 
ramp-2 = 

[module/bitcoin]
type = custom/script
exec = ~/scripts/bitcoin-quote.sh
interval = 30
format-foreground = ${colors.yellow}
format-underline = ${colors.yellow}

[module/headset]
type = custom/script
exec = ~/scripts/headphones-battery
interval = 30
format-foreground = ${colors.purple}
format-underline = ${colors.purple}

[module/mousebattery]
type = custom/script
exec = ~/scripts/mouse-battery.sh
interval = 30
format-foreground = ${colors.green}
format-underline = ${colors.green}

[module/keyboardbattery]
type = custom/script
exec = ~/scripts/keyboard-battery.sh
interval = 30
format-foreground = ${colors.cyan}
format-underline = ${colors.cyan}

; claude-usage / codex-usage only emit Waybar JSON; ai-usage-polybar.sh extracts
; it for polybar. The bar line rewrites Pango markup to %{F}/%{u} tags, so icon
; and underline both carry the binary's brand color (red on error) and no static
; format-underline is set here. click-left pops the 5h/7d breakdown via dunst
; (polybar has no hover tooltips). interval = 60 to spare the authed endpoint.
[module/claudeusage]
type = custom/script
exec = ~/scripts/ai-usage-polybar.sh claude
click-left = ~/scripts/ai-usage-polybar.sh claude popup
interval = 60

[module/codexusage]
type = custom/script
exec = ~/scripts/ai-usage-polybar.sh codex
click-left = ~/scripts/ai-usage-polybar.sh codex popup
interval = 60

[settings]
screenchange-reload = true
pseudo-transparency = false

[global/wm]
margin-top = 0
margin-bottom = 0
